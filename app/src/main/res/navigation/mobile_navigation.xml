    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.imot.endear.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_find_people"
        android:name="com.imot.endear.ui.find_people.FindPeopleFragment"
        android:label="@string/Look_around"
        tools:layout="@layout/fragment_findpeople" />

    <fragment
        android:id="@+id/nav_friend_request"
        android:name="com.imot.endear.ui.friend_request.FriendRequestFragment"
        android:label="@string/Notifications"
        tools:layout="@layout/fragment_friendrequest" />

    <fragment
        android:id="@+id/nav_friend_list"
        android:name="com.imot.endear.ui.add_people.AddPeopleFragment"
        android:label="@string/friend_list"
        tools:layout="@layout/fragment_friends_list" />

    <fragment
        android:id="@+id/nav_sign_out"
